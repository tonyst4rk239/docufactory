# Copia este archivo como .env y llena tus claves.

# Opcional si importas guiones externos con `make_video.py importar <guion.json>`.
# Requerido solo si usas `nuevo`/`auto` con generación por IA (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Cloud TTS (proyecto con facturación + "Cloud Text-to-Speech API" habilitada).
# API key creada en https://console.cloud.google.com/apis/credentials (restríngela a Text-to-Speech)
GOOGLE_TTS_API_KEY=

# https://www.pexels.com/api/  y  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Opcional: Freesound API v2 (https://freesound.org/apiv2/apply/) para descargar SFX CC0 en scripts/descargar_assets.py
FREESOUND_API_KEY=

# Opcional: respaldo para Google Trends (https://serpapi.com)
SERPAPI_KEY=

# Opcional: ruta a un cookies.txt (formato Netscape) exportado de un navegador con sesión de YouTube.
# Necesario en servidores donde YouTube responde "Sign in to confirm you're not a bot".
# Ruta absoluta o relativa a la raíz del repo. NUNCA subas el archivo de cookies al repo.
YTDLP_COOKIES=

# Modelos de respaldo cuando se usa Gemini (gemini-2.5-pro fue retirado; usar gemini-3.1-pro-preview)
MODELO_GUION=gemini-3.1-pro-preview
MODELO_ESTRUCTURA=gemini-3.1-pro-preview
MODELO_JUEZ=gemini-2.5-flash
MODELO_IMAGEN=gemini-2.5-flash-image

# Voz Chirp 3 HD (lista: https://cloud.google.com/text-to-speech/docs/chirp3-hd)
TTS_IDIOMA=es-US
TTS_VOZ=es-US-Chirp3-HD-Charon

# Voz de los Reels/Shorts verticales (make_tiktok.py). Respaldo automático: edge:es-MX-JorgeNeural
#   VOZ_REEL=gemini:Charon           -> Gemini TTS (usa GEMINI_API_KEY; 1 petición por escena)
#   VOZ_REEL=edge:es-MX-JorgeNeural  -> la voz anterior, sin Gemini
VOZ_REEL=gemini:Charon
# GEMINI_TTS_MODELO=gemini-2.5-flash-preview-tts
# GEMINI_TTS_TEMPO=1.0        (ej. 1.08 para acelerar un 8 %)
# VOZ_REEL_REGENERAR=1        (ignora la locución ya generada y la vuelve a pedir)
