# Copia este archivo como .env y llena tus claves.

# Google AI Studio (https://aistudio.google.com/apikey) -> guion, juez visual, imágenes
GEMINI_API_KEY=

# Google Cloud TTS (proyecto con facturación + "Cloud Text-to-Speech API" habilitada).
# API key creada en https://console.cloud.google.com/apis/credentials (restríngela a Text-to-Speech)
GOOGLE_TTS_API_KEY=

# https://www.pexels.com/api/  y  https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Opcional: respaldo para Google Trends (https://serpapi.com)
SERPAPI_KEY=

# Modelos (puedes cambiarlos sin tocar código)
MODELO_GUION=gemini-2.5-pro
MODELO_ESTRUCTURA=gemini-2.5-pro
MODELO_JUEZ=gemini-2.5-flash
MODELO_IMAGEN=gemini-2.5-flash-image

# Voz Chirp 3 HD (lista: https://cloud.google.com/text-to-speech/docs/chirp3-hd)
TTS_IDIOMA=es-US
TTS_VOZ=es-US-Chirp3-HD-Charon
